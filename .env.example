# Application Environment
APP_ENV=production

# Database Connection (SQLite default, or PostgreSQL for cloud deployment)
DATABASE_URL=sqlite:///./repojanitor.db

# AI Provider Configuration ("gemini", "ollama", "auto", or "mock")
AI_PROVIDER=auto

# Google Gemini / Gemma API (Recommended for Cloud Deployment)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Alternative Google Models: gemini-2.0-flash, gemma-2-9b-it, gemma-2-27b-it

# Local Ollama Configuration (For Local Machine / Offline Development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# GitHub Integration (Optional - PR preview mode works without token)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
